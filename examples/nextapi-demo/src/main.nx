// NextAPI Showcase Application
// Demonstrates REST endpoints, dynamic routing, parameter validation, modular routers, and OpenAPI documentation

import nextapi;

fn main() -> Void {
    var app: NextAPI = NextAPI("NextAPI Showcase API", "1.0.0", "Interactive Async REST API built with NextLang");

    // Root Welcome Endpoint
    app.get("/", "Root Welcome", "Welcome message and API index", "general");

    // Modular API Router for /api/v1
    var v1: Router = Router("/api/v1");
    v1.get("/health", "Health Status", "Returns operational health and uptime", "system");
    v1.get("/users", "List Users", "Returns collection of registered users", "users");
    v1.get("/users/{id}", "Get User", "Returns individual user details by typed ID", "users");
    v1.post("/users", "Create User", "Creates a new user with JSON payload validation", "users");
    v1.delete("/users/{id}", "Delete User", "Removes a user by ID", "users");

    // Register custom response for health check
    app.set_response("GET", "/api/v1/health", 200, "{\"status\":\"healthy\",\"service\":\"nextapi-demo\",\"version\":\"1.0.0\"}");
    app.set_response("GET", "/api/v1/users", 200, "{\"users\":[{\"id\":1,\"name\":\"Alice\"},{\"id\":2,\"name\":\"Bob\"}]}");

    // Mount modular router
    app.include_router(v1);

    vout("[NextAPI Demo] Starting server at http://127.0.0.1:8000");
    vout("[NextAPI Demo] Open http://127.0.0.1:8000/docs for Swagger UI interactive testing");
    vout("[NextAPI Demo] Open http://127.0.0.1:8000/redoc for ReDoc interface");
    vout("[NextAPI Demo] Open http://127.0.0.1:8000/openapi.json for OpenAPI 3.0.3 specification");

    return;
}

main();
