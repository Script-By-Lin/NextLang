{
  "name": "nextlang",
  "displayName": "NextLang",
  "description": "Official NextLang language support, syntax highlighting, and file icons for .nx files.",
  "version": "0.1.0",
  "publisher": "nextlang",
  "icon": "icons/nextlang.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nextlang",
        "aliases": [
          "NextLang",
          "nextlang",
          "nx"
        ],
        "extensions": [
          ".nx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/nextlang.svg",
          "dark": "./icons/nextlang.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "nextlang",
        "scopeName": "source.nextlang",
        "path": "./syntaxes/nextlang.tmLanguage.json"
      }
    ]
  }
}
