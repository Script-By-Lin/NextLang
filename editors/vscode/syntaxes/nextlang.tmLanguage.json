{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NextLang",
  "scopeName": "source.nextlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nextlang",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.nextlang",
          "match": "#.*$"
        },
        {
          "name": "comment.block.nextlang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nextlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nextlang",
          "match": "\\\\."
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.nextlang",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.nextlang",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nextlang",
          "match": "\\b(if|otherwise|else|fr|As|loop|skip|halt|match|case|return)\\b"
        },
        {
          "name": "keyword.declaration.nextlang",
          "match": "\\b(var|const|tem|fn|class|interface|struct|extern|unsafe)\\b"
        },
        {
          "name": "storage.modifier.nextlang",
          "match": "\\b(public|private|protected|static|abstract|extends|implements|alloc|free)\\b"
        },
        {
          "name": "variable.language.nextlang",
          "match": "\\b(self|super)\\b"
        },
        {
          "name": "constant.language.nextlang",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.nextlang",
          "match": "\\b(INT8|INT16|INT32|INT64|INT128|UINT8|UINT16|UINT32|UINT64|UINT128|USIZE|ISIZE|usize|isize|FL32|FL64|FL128|BOOL|CHAR|STRING|PTR|ptr|VOID|ANY|LIST|SET|MAP)\\b"
        },
        {
          "name": "entity.name.type.class.nextlang",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nextlang",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.nextlang",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.nextlang",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.nextlang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.nextlang",
          "match": "\\b(vout|input|to_int|to_float|len|file_open|file_close|file_read_all|file_read_str|file_write|file_exists|file_remove|env_get|env_set|get_cwd|get_pid|buffer_new|buffer_free|buffer_size|buffer_get_u8|buffer_set_u8|buffer_get_u32_le|buffer_set_u32_le|buffer_get_i32_le|buffer_set_i32_le|ptr_offset|ptr_read_u8|ptr_write_u8)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.nextlang" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.bitwise.nextlang",
          "match": "<<|>>|\\^|~|&|\\|"
        },
        {
          "name": "keyword.operator.comparison.nextlang",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.nextlang",
          "match": "\\+\\+|--|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.nextlang",
          "match": "="
        }
      ]
    }
  }
}
