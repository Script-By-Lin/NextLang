// NextAPI - Automatic OpenAPI Documentation & Interactive API Testing
// OpenAPI 3.0.3 specification generator, interactive Swagger UI with live testing, and ReDoc interface

fn build_openapi_param(param_name: String) -> String {
    return "{\"name\":\"" + param_name + "\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}}";
}

fn extract_route_params_json(path: String) -> String {
    var np: String = normalize_path(path);
    var seg_cnt: Int32 = count_segments(np);
    var params_json: String = "";
    var count: Int32 = 0;
    var s: Int32 = 0;
    As s < seg_cnt {
        var seg: String = get_segment(np, s);
        if str_starts_with(seg, "{") & str_ends_with(seg, "}") {
            var plen: Int64 = str_len(seg);
            var pname: String = str_sub(seg, 1, plen - 2);
            if count > 0 {
                params_json = params_json + ",";
            }
            params_json = params_json + build_openapi_param(pname);
            count++;
        }
        s++;
    }
    return params_json;
}

fn generate_openapi_json(title: String, version: String, description: String, router: Router) -> String {
    var out: String = "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"" + title + "\",\"version\":\"" + version + "\",\"description\":\"" + description + "\"},\"paths\":{";
    
    // 1. Collect unique paths preserving registration order
    var unique_paths: String = "|";
    var total_routes: Int32 = router.route_count;
    var i: Int32 = 0;
    As i < total_routes {
        var p: String = router.get_route_path(i);
        var marker: String = "|" + p + "|";
        if not str_contains(unique_paths, marker) {
            unique_paths = unique_paths + p + "|";
        }
        i++;
    }

    // 2. Iterate each unique path and aggregate its HTTP methods
    var path_idx: Int32 = 0;
    var u_len: Int64 = str_len(unique_paths);
    var u_pos: Int64 = 1;
    As u_pos < u_len {
        var end_p: Int64 = u_pos;
        var found_end: Bool = false;
        As (end_p < u_len) & (not found_end) {
            if str_sub(unique_paths, end_p, 1) == "|" {
                found_end = true;
            } else {
                end_p++;
            }
        }
        if found_end {
            var cur_path: String = str_sub(unique_paths, u_pos, end_p - u_pos);
            if path_idx > 0 {
                out = out + ",";
            }
            out = out + "\"" + cur_path + "\":{";

            // Iterate all routes matching cur_path
            var method_idx: Int32 = 0;
            var r: Int32 = 0;
            As r < total_routes {
                var r_p: String = router.get_route_path(r);
                if r_p == cur_path {
                    var m: String = str_lower(router.get_route_method(r));
                    var sum: String = router.get_route_summary(r);
                    var desc: String = router.get_route_desc(r);
                    var tag: String = router.get_route_tag(r);

                    if method_idx > 0 {
                        out = out + ",";
                    }
                    out = out + "\"" + m + "\":{";
                    out = out + "\"summary\":\"" + sum + "\",";
                    out = out + "\"description\":\"" + desc + "\",";
                    out = out + "\"tags\":[\"" + tag + "\"],";

                    var params: String = extract_route_params_json(cur_path);
                    if str_len(params) > 0 {
                        out = out + "\"parameters\":[" + params + "],";
                    }

                    if (m == "post") | (m == "put") | (m == "patch") {
                        out = out + "\"requestBody\":{\"description\":\"Request payload\",\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\"}}}},";
                    }

                    out = out + "\"responses\":{";
                    if m == "post" {
                        out = out + "\"201\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\"}}}}";
                    } else {
                        out = out + "\"200\":{\"description\":\"Successful Response\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\"}}}}";
                    }
                    var has_validation: Bool = (str_len(params) > 0) | (m == "post") | (m == "put") | (m == "patch");
                    if has_validation {
                        out = out + ",\"422\":{\"description\":\"Validation Error\"}";
                    }
                    out = out + "}}";

                    method_idx++;
                }
                r++;
            }

            out = out + "}";
            path_idx++;
            u_pos = end_p + 1;
        } else {
            u_pos = u_len;
        }
    }

    out = out + "}}";
    return out;
}

fn generate_swagger_ui_html(title: String, openapi_url: String) -> String {
    var html: String = "<!DOCTYPE html>\n<html>\n<head>\n";
    html = html + "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n";
    html = html + "<title>" + title + " - NextAPI Docs</title>\n";
    html = html + "<link rel=\"icon\" type=\"image/svg+xml\" href=\"/assets/nextlang.svg\">\n";
    html = html + "<link rel=\"stylesheet\" type=\"text/css\" href=\"https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui.css\">\n";
    html = html + "<style>\n";
    html = html + "html { box-sizing: border-box; overflow-y: scroll; }\n";
    html = html + "*, *:before, *:after { box-sizing: inherit; }\n";
    html = html + "body { margin: 0; background: #0B0F19; color: #F1F5F9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }\n";
    html = html + ".swagger-ui .topbar { display: none; }\n";
    html = html + ".next-navbar { background: #0B0F19; border-bottom: 1px solid #222B3D; position: sticky; top: 0; z-index: 100; backdrop-filter: blur(8px); }\n";
    html = html + ".next-nav-inner { max-width: 1200px; margin: 0 auto; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; }\n";
    html = html + ".next-brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }\n";
    html = html + ".next-logo { width: 32px; height: 32px; display: block; }\n";
    html = html + ".next-title-wrap { display: flex; align-items: center; gap: 8px; }\n";
    html = html + ".next-title-main { font-size: 18px; font-weight: 800; color: #FFFFFF; letter-spacing: -0.5px; }\n";
    html = html + ".next-coral { color: #E6725B; }\n";
    html = html + ".next-badge { background: rgba(230, 114, 91, 0.15); color: #E6725B; border: 1px solid rgba(230, 114, 91, 0.4); font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; }\n";
    html = html + ".next-links { display: flex; align-items: center; gap: 8px; }\n";
    html = html + ".next-link { color: #94A3B8; text-decoration: none; font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 6px; transition: all 0.15s; }\n";
    html = html + ".next-link:hover { color: #F8FAFC; background: #161C2D; }\n";
    html = html + ".next-link.active { color: #E6725B; background: rgba(230, 114, 91, 0.1); border: 1px solid rgba(230, 114, 91, 0.25); }\n";
    html = html + ".swagger-ui { max-width: 1200px; margin: 0 auto; padding: 20px 24px 60px 24px; color: #F1F5F9; }\n";
    html = html + ".swagger-ui .info { margin: 24px 0 20px 0; }\n";
    html = html + ".swagger-ui .info .title { font-size: 32px; font-weight: 800; color: #FFFFFF; display: inline-flex; align-items: center; gap: 12px; }\n";
    html = html + ".swagger-ui .info p { font-size: 15px; color: #94A3B8; line-height: 1.6; margin: 10px 0; }\n";
    html = html + ".swagger-ui .info .version { background: #E6725B; color: #FFFFFF; padding: 2px 10px; border-radius: 12px; font-size: 13px; font-weight: 700; }\n";
    html = html + ".swagger-ui .info .oas-badge { background: #161C2D; color: #E6725B; border: 1px solid #E6725B; padding: 2px 8px; border-radius: 12px; font-size: 12px; font-weight: 700; margin-left: 6px; }\n";
    html = html + ".swagger-ui .info a.spec-link { color: #E6725B; text-decoration: none; font-size: 13px; font-family: monospace; display: inline-block; margin-top: 6px; }\n";
    html = html + ".swagger-ui .info a.spec-link:hover { text-decoration: underline; }\n";
    html = html + ".swagger-ui .scheme-container { background: #131826; border-radius: 8px; border: 1px solid #222B3D; box-shadow: none; margin-bottom: 24px; }\n";
    html = html + ".swagger-ui .opblock-tag { font-size: 22px; font-weight: 700; color: #F1F5F9; border-bottom: 1px solid #222B3D; margin: 24px 0 12px 0; padding-bottom: 8px; }\n";
    html = html + ".swagger-ui .opblock-tag small { color: #94A3B8; font-size: 14px; }\n";
    html = html + ".swagger-ui .opblock { margin-bottom: 14px; border-radius: 8px; background: #131826; box-shadow: 0 2px 8px rgba(0,0,0,0.25); border-width: 1px; border-style: solid; transition: border-color 0.15s; }\n";
    html = html + ".swagger-ui .opblock.opblock-get { border-color: rgba(56, 189, 248, 0.35); background: rgba(56, 189, 248, 0.04); }\n";
    html = html + ".swagger-ui .opblock.opblock-get .opblock-summary-method { background: #0284c7; color: #fff; }\n";
    html = html + ".swagger-ui .opblock.opblock-post { border-color: rgba(230, 114, 91, 0.45); background: rgba(230, 114, 91, 0.06); }\n";
    html = html + ".swagger-ui .opblock.opblock-post .opblock-summary-method { background: #E6725B; color: #fff; }\n";
    html = html + ".swagger-ui .opblock.opblock-put { border-color: rgba(245, 158, 11, 0.35); background: rgba(245, 158, 11, 0.04); }\n";
    html = html + ".swagger-ui .opblock.opblock-put .opblock-summary-method { background: #d97706; color: #fff; }\n";
    html = html + ".swagger-ui .opblock.opblock-delete { border-color: rgba(239, 68, 68, 0.35); background: rgba(239, 68, 68, 0.04); }\n";
    html = html + ".swagger-ui .opblock.opblock-delete .opblock-summary-method { background: #dc2626; color: #fff; }\n";
    html = html + ".swagger-ui .opblock.opblock-patch { border-color: rgba(168, 85, 247, 0.35); background: rgba(168, 85, 247, 0.04); }\n";
    html = html + ".swagger-ui .opblock.opblock-patch .opblock-summary-method { background: #9333ea; color: #fff; }\n";
    html = html + ".swagger-ui .opblock .opblock-summary { padding: 10px 16px; align-items: center; }\n";
    html = html + ".swagger-ui .opblock .opblock-summary-method { font-weight: 700; border-radius: 6px; min-width: 75px; text-align: center; font-size: 13px; }\n";
    html = html + ".swagger-ui .opblock .opblock-summary-path { font-family: monospace; font-weight: 600; font-size: 15px; color: #F1F5F9; }\n";
    html = html + ".swagger-ui .opblock .opblock-summary-description { font-size: 13px; color: #94A3B8; margin-left: 16px; }\n";
    html = html + ".swagger-ui .opblock-body { background: #0E131F; border-top: 1px solid #1E293B; padding: 16px; }\n";
    html = html + ".swagger-ui .opblock-section-header { background: #161C2D; border-bottom: 1px solid #222B3D; }\n";
    html = html + ".swagger-ui .opblock-section-header h4 { color: #F1F5F9; font-weight: 700; }\n";
    html = html + ".swagger-ui table.parameters { background: transparent; }\n";
    html = html + ".swagger-ui table.parameters thead th { color: #94A3B8; border-bottom: 1px solid #222B3D; }\n";
    html = html + ".swagger-ui table.parameters tr td { border-bottom: 1px solid #1A2333; color: #CBD5E1; }\n";
    html = html + ".swagger-ui .parameter__name { color: #F8FAFC; font-weight: 600; }\n";
    html = html + ".swagger-ui .parameter__type { color: #E6725B; font-family: monospace; }\n";
    html = html + ".swagger-ui input[type=text], .swagger-ui textarea, .swagger-ui select { background: #0B0F19; border: 1px solid #2C354D; color: #F1F5F9; border-radius: 6px; padding: 6px 10px; font-family: monospace; }\n";
    html = html + ".swagger-ui input[type=text]:focus, .swagger-ui textarea:focus { border-color: #E6725B; outline: none; box-shadow: 0 0 0 2px rgba(230, 114, 91, 0.25); }\n";
    html = html + ".swagger-ui .btn.try-out__btn { border: 1px solid #E6725B; color: #E6725B; background: transparent; font-weight: 600; border-radius: 6px; padding: 6px 14px; transition: all 0.15s; }\n";
    html = html + ".swagger-ui .btn.try-out__btn:hover { background: #E6725B; color: #FFFFFF; }\n";
    html = html + ".swagger-ui .btn.execute { background: linear-gradient(135deg, #E6725B 0%, #FF7E65 100%); color: #FFFFFF; border: none; font-weight: 700; border-radius: 6px; padding: 8px 24px; box-shadow: 0 2px 10px rgba(230, 114, 91, 0.35); cursor: pointer; }\n";
    html = html + ".swagger-ui .btn.execute:hover { box-shadow: 0 4px 14px rgba(230, 114, 91, 0.5); }\n";
    html = html + ".swagger-ui .btn.cancel { border: 1px solid #475569; color: #94A3B8; background: transparent; border-radius: 6px; }\n";
    html = html + ".swagger-ui .responses-inner { background: #0E131F; }\n";
    html = html + ".swagger-ui .responses-table thead th { color: #94A3B8; border-bottom: 1px solid #222B3D; }\n";
    html = html + ".swagger-ui .responses-table tr td { border-bottom: 1px solid #1A2333; }\n";
    html = html + ".swagger-ui .response-col_status { color: #34D399; font-weight: 700; font-family: monospace; }\n";
    html = html + ".swagger-ui .response-col_description { color: #CBD5E1; }\n";
    html = html + ".swagger-ui .highlight-code, .swagger-ui .microlight { background: #080C14 !important; border: 1px solid #222B3D; border-radius: 6px; color: #38BDF8 !important; }\n";
    html = html + ".swagger-ui .model-box { background: #131826; border: 1px solid #222B3D; border-radius: 6px; }\n";
    html = html + ".swagger-ui .model { color: #CBD5E1; }\n";
    html = html + ".swagger-ui .prop-type { color: #E6725B; }\n";
    html = html + ".swagger-ui .filter .operation-filter-input { background: #131826; border: 1px solid #222B3D; color: #F1F5F9; border-radius: 6px; padding: 8px 14px; }\n";
    html = html + ".swagger-ui .filter .operation-filter-input:focus { border-color: #E6725B; outline: none; }\n";
    html = html + "</style>\n</head>\n<body>\n";
    html = html + "<header class=\"next-navbar\">\n  <div class=\"next-nav-inner\">\n";
    html = html + "    <a href=\"/docs\" class=\"next-brand\">\n";
    html = html + "      <svg class=\"next-logo\" viewBox=\"0 0 128 128\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n";
    html = html + "        <rect width=\"128\" height=\"128\" rx=\"28\" fill=\"#161C2D\"/>\n";
    html = html + "        <path d=\"M32 96V32L96 96V32\" stroke=\"#E6725B\" stroke-width=\"14\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n";
    html = html + "      </svg>\n";
    html = html + "      <div class=\"next-title-wrap\">\n";
    html = html + "        <span class=\"next-title-main\">Next<span class=\"next-coral\">API</span></span>\n";
    html = html + "        <span class=\"next-badge\">Interactive Docs</span>\n";
    html = html + "      </div>\n    </a>\n";
    html = html + "    <div class=\"next-links\">\n";
    html = html + "      <a href=\"/docs\" class=\"next-link active\">Swagger UI</a>\n";
    html = html + "      <a href=\"/redoc\" class=\"next-link\">ReDoc</a>\n";
    html = html + "      <a href=\"" + openapi_url + "\" target=\"_blank\" class=\"next-link\">OpenAPI JSON</a>\n";
    html = html + "    </div>\n  </div>\n</header>\n";
    html = html + "<div id=\"swagger-ui\"></div>\n";
    html = html + "<script src=\"https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui-bundle.js\"></script>\n";
    html = html + "<script src=\"https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui-standalone-preset.js\"></script>\n";
    html = html + "<script>\n";
    html = html + "window.onload = function() {\n";
    html = html + "  if (typeof SwaggerUIBundle !== 'undefined') {\n";
    html = html + "    window.ui = SwaggerUIBundle({\n";
    html = html + "      url: '" + openapi_url + "',\n";
    html = html + "      dom_id: '#swagger-ui',\n";
    html = html + "      deepLinking: true,\n";
    html = html + "      presets: [\n";
    html = html + "        SwaggerUIBundle.presets.apis,\n";
    html = html + "        SwaggerUIStandalonePreset\n";
    html = html + "      ],\n";
    html = html + "      layout: 'BaseLayout',\n";
    html = html + "      docExpansion: 'list',\n";
    html = html + "      showExtensions: true,\n";
    html = html + "      showCommonExtensions: true,\n";
    html = html + "      displayRequestDuration: true,\n";
    html = html + "      filter: true\n";
    html = html + "    });\n";
    html = html + "  } else {\n";
    html = html + "    document.getElementById('swagger-ui').innerHTML = '<div style=\"padding:40px;text-align:center;\"><h2>Loading OpenAPI Documentation...</h2><p>Please check your connection to jsdelivr CDN or view <a href=\"' + '" + openapi_url + "' + '\">' + '" + openapi_url + "' + '</a></p></div>';\n";
    html = html + "  }\n";
    html = html + "};\n";
    html = html + "</script>\n</body>\n</html>";
    return html;
}

fn generate_redoc_html(title: String, openapi_url: String) -> String {
    var html: String = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n";
    html = html + "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n";
    html = html + "<title>" + title + " - ReDoc</title>\n";
    html = html + "<link rel=\"icon\" type=\"image/svg+xml\" href=\"/assets/nextlang.svg\">\n";
    html = html + "<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">\n";
    html = html + "<style>\n";
    html = html + "body { margin: 0; padding: 0; background: #0B0F19; font-family: 'Inter', -apple-system, sans-serif; }\n";
    html = html + ".next-navbar { background: #0B0F19; border-bottom: 1px solid #222B3D; position: sticky; top: 0; z-index: 100; }\n";
    html = html + ".next-nav-inner { max-width: 1200px; margin: 0 auto; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; }\n";
    html = html + ".next-brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }\n";
    html = html + ".next-logo { width: 32px; height: 32px; display: block; }\n";
    html = html + ".next-title-wrap { display: flex; align-items: center; gap: 8px; }\n";
    html = html + ".next-title-main { font-size: 18px; font-weight: 800; color: #FFFFFF; letter-spacing: -0.5px; }\n";
    html = html + ".next-coral { color: #E6725B; }\n";
    html = html + ".next-badge { background: rgba(230, 114, 91, 0.15); color: #E6725B; border: 1px solid rgba(230, 114, 91, 0.4); font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; }\n";
    html = html + ".next-links { display: flex; align-items: center; gap: 8px; }\n";
    html = html + ".next-link { color: #94A3B8; text-decoration: none; font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 6px; transition: all 0.15s; }\n";
    html = html + ".next-link:hover { color: #F8FAFC; background: #161C2D; }\n";
    html = html + ".next-link.active { color: #E6725B; background: rgba(230, 114, 91, 0.1); border: 1px solid rgba(230, 114, 91, 0.25); }\n";
    html = html + "</style>\n";
    html = html + "</head>\n<body>\n";
    html = html + "<header class=\"next-navbar\">\n  <div class=\"next-nav-inner\">\n";
    html = html + "    <a href=\"/docs\" class=\"next-brand\">\n";
    html = html + "      <svg class=\"next-logo\" viewBox=\"0 0 128 128\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n";
    html = html + "        <rect width=\"128\" height=\"128\" rx=\"28\" fill=\"#161C2D\"/>\n";
    html = html + "        <path d=\"M32 96V32L96 96V32\" stroke=\"#E6725B\" stroke-width=\"14\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n";
    html = html + "      </svg>\n";
    html = html + "      <div class=\"next-title-wrap\">\n";
    html = html + "        <span class=\"next-title-main\">Next<span class=\"next-coral\">API</span></span>\n";
    html = html + "        <span class=\"next-badge\">ReDoc</span>\n";
    html = html + "      </div>\n    </a>\n";
    html = html + "    <div class=\"next-links\">\n";
    html = html + "      <a href=\"/docs\" class=\"next-link\">Swagger UI</a>\n";
    html = html + "      <a href=\"/redoc\" class=\"next-link active\">ReDoc</a>\n";
    html = html + "      <a href=\"" + openapi_url + "\" target=\"_blank\" class=\"next-link\">OpenAPI JSON</a>\n";
    html = html + "    </div>\n  </div>\n</header>\n";
    html = html + "<redoc spec-url=\"" + openapi_url + "\" theme='{\"colors\":{\"primary\":{\"main\":\"#E6725B\"}},\"sidebar\":{\"backgroundColor\":\"#0E131F\",\"textColor\":\"#CBD5E1\"},\"rightPanel\":{\"backgroundColor\":\"#080C14\"}}'></redoc>\n";
    html = html + "<script src=\"https://cdn.redoc.ly/redoc/latest/bundles/redoc.standalone.js\"></script>\n";
    html = html + "</body>\n</html>";
    return html;
}

