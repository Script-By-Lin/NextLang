// NextAPI - Automatic OpenAPI Documentation & Interactive API Testing
// OpenAPI 3.0.3 specification generator, interactive Swagger UI with live testing, and ReDoc interface

fn build_openapi_param(param_name: String) -> String {
    return "{\"name\":\"" + param_name + "\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}}";
}

fn extract_route_params_json(path: String) -> String {
    var np: String = normalize_path(path);
    var seg_cnt: Int32 = count_segments(np);
    var params_json: String = "";
    var count: Int32 = 0;
    var s: Int32 = 0;
    As s < seg_cnt {
        var seg: String = get_segment(np, s);
        if str_starts_with(seg, "{") & str_ends_with(seg, "}") {
            var plen: Int64 = str_len(seg);
            var pname: String = str_sub(seg, 1, plen - 2);
            if count > 0 {
                params_json = params_json + ",";
            }
            params_json = params_json + build_openapi_param(pname);
            count++;
        }
        s++;
    }
    return params_json;
}

fn generate_openapi_json(title: String, version: String, description: String, router: Router) -> String {
    var out: String = "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"" + title + "\",\"version\":\"" + version + "\",\"description\":\"" + description + "\"},\"paths\":{";
    
    // 1. Collect unique paths preserving registration order
    var unique_paths: String = "";
    var total_routes: Int32 = router.route_count;
    var i: Int32 = 0;
    As i < total_routes {
        var p: String = router.get_route_path(i);
        var marker: String = "::" + p + "::";
        if not str_contains(unique_paths, marker) {
            unique_paths = unique_paths + marker;
        }
        i++;
    }

    // 2. Iterate each unique path and aggregate its HTTP methods
    var path_idx: Int32 = 0;
    var u_len: Int64 = str_len(unique_paths);
    var u_pos: Int64 = 0;
    As u_pos < u_len {
        if str_sub(unique_paths, u_pos, 2) == "::" {
            var start_p: Int64 = u_pos + 2;
            var end_p: Int64 = start_p;
            var found_end: Bool = false;
            As (end_p <= u_len - 2) & (not found_end) {
                if str_sub(unique_paths, end_p, 2) == "::" {
                    found_end = true;
                } else {
                    end_p++;
                }
            }
            if found_end {
                var cur_path: String = str_sub(unique_paths, start_p, end_p - start_p);
                if path_idx > 0 {
                    out = out + ",";
                }
                out = out + "\"" + cur_path + "\":{";

                // Iterate all routes matching cur_path
                var method_idx: Int32 = 0;
                var r: Int32 = 0;
                As r < total_routes {
                    var r_p: String = router.get_route_path(r);
                    if r_p == cur_path {
                        var m: String = str_lower(router.get_route_method(r));
                        var sum: String = router.get_route_summary(r);
                        var desc: String = router.get_route_desc(r);
                        var tag: String = router.get_route_tag(r);

                        if method_idx > 0 {
                            out = out + ",";
                        }
                        out = out + "\"" + m + "\":{";
                        out = out + "\"summary\":\"" + sum + "\",";
                        out = out + "\"description\":\"" + desc + "\",";
                        out = out + "\"tags\":[\"" + tag + "\"],";

                        var params: String = extract_route_params_json(cur_path);
                        if str_len(params) > 0 {
                            out = out + "\"parameters\":[" + params + "],";
                        }

                        if (m == "post") | (m == "put") | (m == "patch") {
                            out = out + "\"requestBody\":{\"description\":\"Request payload\",\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\"}}}},";
                        }

                        out = out + "\"responses\":{";
                        out = out + "\"200\":{\"description\":\"Successful operation\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\"}}}},";
                        out = out + "\"400\":{\"description\":\"Malformed request syntax or framing error\"},";
                        out = out + "\"404\":{\"description\":\"Resource not found\"},";
                        out = out + "\"422\":{\"description\":\"Validation error in request parameters or body\"},";
                        out = out + "\"500\":{\"description\":\"Internal server error\"}";
                        out = out + "}}";

                        method_idx++;
                    }
                    r++;
                }

                out = out + "}";
                path_idx++;
                u_pos = end_p;
            } else {
                u_pos = u_len;
            }
        } else {
            u_pos++;
        }
    }

    out = out + "}}";
    return out;
}

fn generate_swagger_ui_html(title: String, openapi_url: String) -> String {
    var html: String = "<!DOCTYPE html>\n<html>\n<head>\n";
    html = html + "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n";
    html = html + "<title>" + title + " - Swagger UI</title>\n";
    html = html + "<link rel=\"stylesheet\" type=\"text/css\" href=\"https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui.css\">\n";
    html = html + "<link rel=\"icon\" type=\"image/png\" href=\"https://fastapi.tiangolo.com/img/favicon.png\">\n";
    html = html + "<style>\n";
    html = html + "html { box-sizing: border-box; overflow: -moz-scrollbars-vertical; overflow-y: scroll; }\n";
    html = html + "*, *:before, *:after { box-sizing: inherit; }\n";
    html = html + "body { margin: 0; background: #fafafa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }\n";
    html = html + ".swagger-ui .topbar { display: none; }\n";
    html = html + ".swagger-ui .info { margin: 30px 0 20px 0; }\n";
    html = html + ".swagger-ui .info .title { font-size: 36px; font-weight: 700; color: #3b4151; display: inline-flex; align-items: center; gap: 10px; }\n";
    html = html + ".swagger-ui .info .version { background: #7d8492; color: #fff; padding: 2px 8px; border-radius: 12px; font-size: 13px; font-weight: 600; }\n";
    html = html + ".swagger-ui .info .oas-badge { background: #49cc90; color: #fff; padding: 2px 8px; border-radius: 12px; font-size: 12px; font-weight: 700; margin-left: 6px; }\n";
    html = html + ".swagger-ui .info a.spec-link { color: #3b82f6; text-decoration: none; font-size: 14px; font-family: monospace; display: block; margin-top: 8px; }\n";
    html = html + ".swagger-ui .info a.spec-link:hover { text-decoration: underline; }\n";
    html = html + ".swagger-ui .opblock-tag { font-size: 24px; font-weight: 700; color: #3b4151; border-bottom: 1px solid rgba(59,65,81,.2); margin: 28px 0 12px 0; padding-bottom: 6px; display: flex; align-items: center; justify-content: space-between; }\n";
    html = html + ".swagger-ui .opblock { margin-bottom: 12px; border-radius: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }\n";
    html = html + ".swagger-ui .opblock .opblock-summary { padding: 8px 16px; }\n";
    html = html + ".swagger-ui .opblock .opblock-summary-method { font-weight: 700; border-radius: 4px; min-width: 70px; text-align: center; }\n";
    html = html + ".swagger-ui .opblock .opblock-summary-path { font-family: monospace; font-weight: 600; font-size: 16px; }\n";
    html = html + ".swagger-ui .opblock .opblock-summary-description { font-size: 14px; color: #555; margin-left: 16px; }\n";
    html = html + ".topbar-links { background: #1e293b; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #334155; }\n";
    html = html + ".topbar-links h2 { margin: 0; font-size: 16px; font-weight: 700; color: #38bdf8; }\n";
    html = html + ".topbar-links a { color: #94a3b8; text-decoration: none; margin-left: 16px; font-size: 13px; font-weight: 500; transition: color 0.15s; }\n";
    html = html + ".topbar-links a:hover { color: #f8fafc; }\n";
    html = html + "</style>\n</head>\n<body>\n";
    html = html + "<div class=\"topbar-links\">\n  <h2>NextAPI Interactive Docs</h2>\n";
    html = html + "  <div>\n    <a href=\"/docs\">Swagger UI</a>\n    <a href=\"/redoc\">ReDoc</a>\n    <a href=\"" + openapi_url + "\" target=\"_blank\">OpenAPI JSON</a>\n  </div>\n</div>\n";
    html = html + "<div id=\"swagger-ui\"></div>\n";
    html = html + "<script src=\"https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui-bundle.js\"></script>\n";
    html = html + "<script src=\"https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui-standalone-preset.js\"></script>\n";
    html = html + "<script>\n";
    html = html + "window.onload = function() {\n";
    html = html + "  if (typeof SwaggerUIBundle !== 'undefined') {\n";
    html = html + "    window.ui = SwaggerUIBundle({\n";
    html = html + "      url: '" + openapi_url + "',\n";
    html = html + "      dom_id: '#swagger-ui',\n";
    html = html + "      deepLinking: true,\n";
    html = html + "      presets: [\n";
    html = html + "        SwaggerUIBundle.presets.apis,\n";
    html = html + "        SwaggerUIStandalonePreset\n";
    html = html + "      ],\n";
    html = html + "      layout: 'BaseLayout',\n";
    html = html + "      docExpansion: 'list',\n";
    html = html + "      showExtensions: true,\n";
    html = html + "      showCommonExtensions: true,\n";
    html = html + "      displayRequestDuration: true,\n";
    html = html + "      filter: true\n";
    html = html + "    });\n";
    html = html + "  } else {\n";
    html = html + "    document.getElementById('swagger-ui').innerHTML = '<div style=\"padding:40px;text-align:center;\"><h2>Loading OpenAPI Documentation...</h2><p>Please check your connection to jsdelivr CDN or view <a href=\"' + '" + openapi_url + "' + '\">' + '" + openapi_url + "' + '</a></p></div>';\n";
    html = html + "  }\n";
    html = html + "};\n";
    html = html + "</script>\n</body>\n</html>";
    return html;
}

fn generate_redoc_html(title: String, openapi_url: String) -> String {
    var html: String = "<html lang=\"en\">\n<head>\n";
    html = html + "<meta charset=\"UTF-8\">\n";
    html = html + "<title>" + title + " - ReDoc</title>\n";
    html = html + "<link href=\"https://fonts.googleapis.com/css?family=Montserrat:300,400,700|Roboto:300,400,700\" rel=\"stylesheet\">\n";
    html = html + "<style>body { margin: 0; padding: 0; background: #fafafa; font-family: Roboto, sans-serif; }</style>\n";
    html = html + "</head>\n<body>\n";
    html = html + "<redoc spec-url=\"" + openapi_url + "\"></redoc>\n";
    html = html + "<script src=\"https://cdn.redoc.ly/redoc/latest/bundles/redoc.standalone.js\"></script>\n";
    html = html + "</body>\n</html>";
    return html;
}
