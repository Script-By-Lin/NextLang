// NextAPI - Automatic OpenAPI Documentation & Interactive API Testing
// OpenAPI 3.0.3 specification generator, interactive Swagger UI with live testing, and ReDoc interface

fn build_openapi_param(param_name: String) -> String {
    return "{\"name\":\"" + param_name + "\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}}";
}

fn extract_route_params_json(path: String) -> String {
    var np: String = normalize_path(path);
    var seg_cnt: Int32 = count_segments(np);
    var params_json: String = "";
    var count: Int32 = 0;
    var s: Int32 = 0;
    As s < seg_cnt {
        var seg: String = get_segment(np, s);
        if str_starts_with(seg, "{") & str_ends_with(seg, "}") {
            var plen: Int64 = str_len(seg);
            var pname: String = str_sub(seg, 1, plen - 2);
            if count > 0 {
                params_json = params_json + ",";
            }
            params_json = params_json + build_openapi_param(pname);
            count++;
        }
        s++;
    }
    return params_json;
}

fn generate_openapi_json(title: String, version: String, description: String, router: Router) -> String {
    var out: String = "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"" + title + "\",\"version\":\"" + version + "\",\"description\":\"" + description + "\"},\"paths\":{";
    
    // 1. Collect unique paths preserving registration order
    var unique_paths: String = "";
    var total_routes: Int32 = router.route_count;
    var i: Int32 = 0;
    As i < total_routes {
        var p: String = router.get_route_path(i);
        var marker: String = "::" + p + "::";
        if not str_contains(unique_paths, marker) {
            unique_paths = unique_paths + marker;
        }
        i++;
    }

    // 2. Iterate each unique path and aggregate its HTTP methods
    var path_idx: Int32 = 0;
    var u_len: Int64 = str_len(unique_paths);
    var u_pos: Int64 = 0;
    As u_pos < u_len {
        if str_sub(unique_paths, u_pos, 2) == "::" {
            var start_p: Int64 = u_pos + 2;
            var end_p: Int64 = start_p;
            var found_end: Bool = false;
            As (end_p <= u_len - 2) & (not found_end) {
                if str_sub(unique_paths, end_p, 2) == "::" {
                    found_end = true;
                } else {
                    end_p++;
                }
            }
            if found_end {
                var cur_path: String = str_sub(unique_paths, start_p, end_p - start_p);
                if path_idx > 0 {
                    out = out + ",";
                }
                out = out + "\"" + cur_path + "\":{";

                // Iterate all routes matching cur_path
                var method_idx: Int32 = 0;
                var r: Int32 = 0;
                As r < total_routes {
                    var r_p: String = router.get_route_path(r);
                    if r_p == cur_path {
                        var m: String = str_lower(router.get_route_method(r));
                        var sum: String = router.get_route_summary(r);
                        var desc: String = router.get_route_desc(r);
                        var tag: String = router.get_route_tag(r);

                        if method_idx > 0 {
                            out = out + ",";
                        }
                        out = out + "\"" + m + "\":{";
                        out = out + "\"summary\":\"" + sum + "\",";
                        out = out + "\"description\":\"" + desc + "\",";
                        out = out + "\"tags\":[\"" + tag + "\"],";

                        var params: String = extract_route_params_json(cur_path);
                        if str_len(params) > 0 {
                            out = out + "\"parameters\":[" + params + "],";
                        }

                        if (m == "post") | (m == "put") | (m == "patch") {
                            out = out + "\"requestBody\":{\"description\":\"Request payload\",\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\"}}}},";
                        }

                        out = out + "\"responses\":{";
                        out = out + "\"200\":{\"description\":\"Successful operation\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\"}}}},";
                        out = out + "\"400\":{\"description\":\"Malformed request syntax or framing error\"},";
                        out = out + "\"404\":{\"description\":\"Resource not found\"},";
                        out = out + "\"422\":{\"description\":\"Validation error in request parameters or body\"},";
                        out = out + "\"500\":{\"description\":\"Internal server error\"}";
                        out = out + "}}";

                        method_idx++;
                    }
                    r++;
                }

                out = out + "}";
                path_idx++;
                u_pos = end_p;
            } else {
                u_pos = u_len;
            }
        } else {
            u_pos++;
        }
    }

    out = out + "}}";
    return out;
}

fn generate_swagger_ui_html(title: String, openapi_url: String) -> String {
    var html: String = "<html lang=\"en\">\n<head>\n";
    html = html + "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n";
    html = html + "<title>" + title + " - Interactive API Documentation</title>\n";
    html = html + "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui.css\">\n";
    html = html + "<style>\n";
    html = html + "body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #0f172a; color: #f8fafc; }\n";
    html = html + "#topbar { background: #1e293b; padding: 16px 24px; border-bottom: 1px solid #334155; display: flex; align-items: center; justify-content: space-between; }\n";
    html = html + "#topbar h1 { margin: 0; font-size: 20px; font-weight: 700; color: #38bdf8; }\n";
    html = html + "#topbar a { color: #94a3b8; text-decoration: none; margin-left: 16px; font-size: 14px; }\n";
    html = html + "#topbar a:hover { color: #38bdf8; }\n";
    html = html + "#api-container { max-width: 1200px; margin: 24px auto; padding: 0 16px; }\n";
    html = html + ".card { background: #1e293b; border-radius: 8px; border: 1px solid #334155; margin-bottom: 16px; overflow: hidden; }\n";
    html = html + ".endpoint-header { display: flex; align-items: center; padding: 14px 20px; cursor: pointer; user-select: none; }\n";
    html = html + ".badge { padding: 4px 10px; border-radius: 4px; font-weight: 700; font-size: 12px; margin-right: 14px; min-width: 60px; text-align: center; }\n";
    html = html + ".badge-get { background: #0369a1; color: #e0f2fe; }\n";
    html = html + ".badge-post { background: #15803d; color: #dcfce7; }\n";
    html = html + ".badge-put { background: #b45309; color: #fef3c7; }\n";
    html = html + ".badge-delete { background: #b91c1c; color: #fee2e2; }\n";
    html = html + ".badge-patch { background: #6d28d9; color: #ede9fe; }\n";
    html = html + ".badge-options { background: #475569; color: #f1f5f9; }\n";
    html = html + ".path { font-weight: 600; font-size: 15px; color: #f1f5f9; font-family: monospace; }\n";
    html = html + ".summary { margin-left: 16px; color: #94a3b8; font-size: 14px; flex: 1; }\n";
    html = html + ".endpoint-body { padding: 20px; border-top: 1px solid #334155; background: #0f172a; display: none; }\n";
    html = html + ".form-group { margin-bottom: 14px; }\n";
    html = html + "label { display: block; font-size: 13px; font-weight: 600; color: #94a3b8; margin-bottom: 6px; }\n";
    html = html + "input, textarea { width: 100%; box-sizing: border-box; background: #1e293b; border: 1px solid #475569; border-radius: 6px; padding: 8px 12px; color: #f8fafc; font-family: monospace; font-size: 14px; }\n";
    html = html + "button.btn-execute { background: #0284c7; color: white; border: none; padding: 8px 20px; border-radius: 6px; font-weight: 600; cursor: pointer; transition: background 0.2s; }\n";
    html = html + "button.btn-execute:hover { background: #0369a1; }\n";
    html = html + ".response-box { margin-top: 16px; background: #1e293b; border: 1px solid #334155; border-radius: 6px; padding: 12px; display: none; }\n";
    html = html + ".res-status { font-weight: 700; margin-bottom: 8px; }\n";
    html = html + ".res-status.s-2xx { color: #4ade80; }\n";
    html = html + ".res-status.s-4xx { color: #f87171; }\n";
    html = html + ".res-status.s-5xx { color: #ef4444; }\n";
    html = html + "pre { margin: 0; overflow-x: auto; font-family: monospace; font-size: 13px; color: #cbd5e1; }\n";
    html = html + "</style>\n</head>\n<body>\n";
    html = html + "<div id=\"topbar\">\n  <h1>" + title + " - Interactive API Documentation</h1>\n";
    html = html + "  <div>\n    <a href=\"" + openapi_url + "\" target=\"_blank\">OpenAPI JSON</a>\n    <a href=\"/redoc\">ReDoc</a>\n  </div>\n</div>\n";
    html = html + "<div id=\"api-container\"><p id=\"loading\">Loading interactive API routes...</p></div>\n";
    html = html + "<div id=\"swagger-ui\"></div>\n";
    html = html + "<script>\n";
    html = html + "async function initApp() {\n";
    html = html + "  try {\n";
    html = html + "    var res = await fetch('" + openapi_url + "');\n";
    html = html + "    var spec = await res.json();\n";
    html = html + "    var container = document.getElementById('api-container');\n";
    html = html + "    container.innerHTML = '';\n";
    html = html + "    var epCount = 0;\n";
    html = html + "    var paths = spec.paths || {};\n";
    html = html + "    for (var p in paths) {\n";
    html = html + "      var methods = paths[p];\n";
    html = html + "      for (var m in methods) {\n";
    html = html + "        epCount++;\n";
    html = html + "        var id = 'ep-' + epCount;\n";
    html = html + "        var card = document.createElement('div');\n";
    html = html + "        card.className = 'card';\n";
    html = html + "        var details = methods[m];\n";
    html = html + "        var badgeClass = 'badge badge-' + m.toLowerCase();\n";
    html = html + "        var headHtml = '<div class=\"endpoint-header\" onclick=\"toggleBody(\\'' + id + '\\')\"><span class=\"' + badgeClass + '\">' + m.toUpperCase() + '</span><span class=\"path\">' + p + '</span><span class=\"summary\">' + (details.summary || '') + '</span></div>';\n";
    html = html + "        var hasBody = (m.toLowerCase() == 'post' || m.toLowerCase() == 'put' || m.toLowerCase() == 'patch');\n";
    html = html + "        var bodyField = hasBody ? '<div class=\"form-group\"><label>Request Body (JSON)</label><textarea id=\"body-' + id + '\" rows=\"4\">{}</textarea></div>' : '';\n";
    html = html + "        var bodyHtml = '<div class=\"endpoint-body\" id=\"' + id + '\"><div class=\"form-group\"><label>Target URL</label><input type=\"text\" id=\"url-' + id + '\" value=\"' + p + '\"></div>' + bodyField + '<button class=\"btn-execute\" onclick=\"executeRequest(\\'' + id + '\\', \\'' + m.toUpperCase() + '\\')\">Execute Real Request</button><div class=\"response-box\" id=\"res-' + id + '\"><div class=\"res-status\" id=\"status-' + id + '\"></div><pre id=\"out-' + id + '\"></pre></div></div>';\n";
    html = html + "        card.innerHTML = headHtml + bodyHtml;\n";
    html = html + "        container.appendChild(card);\n";
    html = html + "      }\n";
    html = html + "    }\n";
    html = html + "  } catch (err) {\n";
    html = html + "    document.getElementById('loading').textContent = 'Failed to load OpenAPI spec: ' + err;\n";
    html = html + "  }\n";
    html = html + "}\n";
    html = html + "function toggleBody(id) {\n";
    html = html + "  var el = document.getElementById(id);\n";
    html = html + "  el.style.display = (el.style.display == 'block') ? 'none' : 'block';\n";
    html = html + "}\n";
    html = html + "async function executeRequest(id, method) {\n";
    html = html + "  var url = document.getElementById('url-' + id).value;\n";
    html = html + "  var resBox = document.getElementById('res-' + id);\n";
    html = html + "  var statusEl = document.getElementById('status-' + id);\n";
    html = html + "  var outEl = document.getElementById('out-' + id);\n";
    html = html + "  resBox.style.display = 'block';\n";
    html = html + "  statusEl.textContent = 'Executing...';\n";
    html = html + "  var opts = { method: method, headers: { 'Content-Type': 'application/json' } };\n";
    html = html + "  var bodyEl = document.getElementById('body-' + id);\n";
    html = html + "  if (bodyEl && (method == 'POST' || method == 'PUT' || method == 'PATCH')) {\n";
    html = html + "    opts.body = bodyEl.value;\n";
    html = html + "  }\n";
    html = html + "  try {\n";
    html = html + "    var resp = await fetch(url, opts);\n";
    html = html + "    var st = resp.status;\n";
    html = html + "    statusEl.textContent = 'Status: ' + st + ' ' + resp.statusText;\n";
    html = html + "    statusEl.className = 'res-status ' + (st < 300 ? 's-2xx' : (st < 500 ? 's-4xx' : 's-5xx'));\n";
    html = html + "    var text = await resp.text();\n";
    html = html + "    try { outEl.textContent = JSON.stringify(JSON.parse(text), null, 2); }\n";
    html = html + "    catch (parseErr) { outEl.textContent = text; }\n";
    html = html + "  } catch (e) {\n";
    html = html + "    statusEl.textContent = 'Error: ' + e.message;\n";
    html = html + "    statusEl.className = 'res-status s-5xx';\n";
    html = html + "    outEl.textContent = '';\n";
    html = html + "  }\n";
    html = html + "}\n";
    html = html + "window.onload = initApp;\n";
    html = html + "</script>\n</body>\n</html>";
    return html;
}

fn generate_redoc_html(title: String, openapi_url: String) -> String {
    var html: String = "<html lang=\"en\">\n<head>\n";
    html = html + "<meta charset=\"UTF-8\">\n";
    html = html + "<title>" + title + " - ReDoc</title>\n";
    html = html + "<link href=\"https://fonts.googleapis.com/css?family=Montserrat:300,400,700|Roboto:300,400,700\" rel=\"stylesheet\">\n";
    html = html + "<style>body { margin: 0; padding: 0; background: #fafafa; font-family: Roboto, sans-serif; }</style>\n";
    html = html + "</head>\n<body>\n";
    html = html + "<redoc spec-url=\"" + openapi_url + "\"></redoc>\n";
    html = html + "<script src=\"https://cdn.redoc.ly/redoc/latest/bundles/redoc.standalone.js\"></script>\n";
    html = html + "</body>\n</html>";
    return html;
}
